		// スリープモード無効化に伴いpollは不要に
		//ZPS_eAplZdoPoll();

		/* Re-start any other application software modules
		 * HERE
		 */
	}
	else /* perform any actions require on initial start-up */
	{
		/* Return the device to the start-up start if it was reset during the network formation stage */
		s_eDeviceState.eNodeState = E_STARTUP;
	}
}

/****************************************************************************
 *
 * NAME: APP_taskSleepingEndDevice
 *
 * DESCRIPTION:
 * Main state machine
 *
 * RETURNS:
 * void
 *
 ****************************************************************************/
PUBLIC void APP_vtaskSleepingEndDevice (void)
{
	ZPS_tsAfEvent sStackEvent;


	sStackEvent.eType = ZPS_EVENT_NONE;
    bool_t bEventReady = ZQ_bQueueReceive(&APP_msgZpsEvents, &sStackEvent);
//    if (bEventReady)
//	{
//		DBG_vPrintf(TRACE_APP, "APP: No event to process!\n");
//	}

	switch (s_eDeviceState.eNodeState)
	{
	case E_STARTUP:
	{
		vStartup();
	}
	break;

	case E_DISCOVERY:
	{
		vWaitForNetworkDiscovery(sStackEvent);
	}
	break;

	case E_JOINING_NETWORK:
	{
		vWaitForNetworkJoin(sStackEvent);
	}
	break;

	case E_RUNNING:
	{
	    /* まずは溜まっているイベントを捌く */
	    while (bEventReady) {
	        vHandleStackEvent(sStackEvent);
	        bEventReady = ZQ_bQueueReceive(&APP_msgZpsEvents, &sStackEvent);
	    }

	    /* Rx-on 非スリープでは Data Request を出さない */
	    #if !ED_RX_ON_MODE
	        /* 従来のポーリング運用を使う場合だけ有効化 */
	        if (!bPollOutstanding) {
	            if (ZPS_E_SUCCESS == ZPS_eAplZdoPoll()) {
	                bPollOutstanding = TRUE;
	            }
	        }
	    #endif

	    vReadInputCommand();
	}
	break;

	default:
	{
		/* Do nothing */
	}
	break;
	}
}

